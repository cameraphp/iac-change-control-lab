{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iac-change-control-lab:schema:policy-config:v1",
  "title": "Policy configuration (iac-lab-policy/v1)",
  "description": "Deterministic policy parameters. Rules cannot be disabled and no exception mechanism exists; covered resource types are fixed by the plan contract. Semantic checks (ranges, port overlap) are enforced by plan_loader.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "synthetic",
    "contract_version",
    "policy_id",
    "policy_version",
    "description",
    "terraform_version",
    "provider_allowlist",
    "public_ingress",
    "storage_encryption",
    "required_tags"
  ],
  "properties": {
    "synthetic": { "const": true },
    "contract_version": { "const": "iac-lab-policy/v1" },
    "policy_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
    "policy_version": { "$ref": "#/$defs/semver" },
    "description": { "type": "string", "maxLength": 300 },
    "terraform_version": { "$ref": "#/$defs/version_range" },
    "provider_allowlist": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9]{1,30}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "min_inclusive", "max_exclusive"],
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)*\\.example/[a-z0-9-]+/[a-z0-9-]+$"
          },
          "min_inclusive": { "$ref": "#/$defs/semver" },
          "max_exclusive": { "$ref": "#/$defs/semver" }
        }
      }
    },
    "public_ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensitive_ports", "allowed_public_ports"],
      "properties": {
        "sensitive_ports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/port" }
        },
        "allowed_public_ports": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/port" }
        }
      }
    },
    "storage_encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_algorithms"],
      "properties": {
        "allowed_algorithms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" }
        }
      }
    },
    "required_tags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keys"],
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" }
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "version_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_inclusive", "max_exclusive"],
      "properties": {
        "min_inclusive": { "$ref": "#/$defs/semver" },
        "max_exclusive": { "$ref": "#/$defs/semver" }
      }
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
  }
}
