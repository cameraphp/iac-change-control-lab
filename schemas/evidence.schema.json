{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iac-change-control-lab:schema:evidence:v1",
  "title": "Evidence bundle documents (evaluation.json, provenance.json, approval-assessment.json)",
  "description": "The root validates evaluation.json. Use #/$defs/provenance and #/$defs/approval_assessment for the other JSON files. All evidence is derived from synthetic, local fixtures.",
  "$ref": "#/$defs/evaluation",
  "$defs": {
    "decision": { "enum": ["BLOCKED", "ERROR", "PASS", "WARN"] },
    "exit_code": { "enum": [0, 1, 2] },
    "digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "sha256_or_null": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "iac-change-control-lab" },
        "version": { "type": "string" }
      }
    },
    "scope": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["change_ref", "environment"],
      "properties": {
        "change_ref": { "type": "string" },
        "environment": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "severity",
        "blocking",
        "requires_elevated_approval",
        "address",
        "detail_key",
        "reason",
        "remediation"
      ],
      "properties": {
        "rule_id": { "type": "string", "pattern": "^IAC-[A-Z]{3}-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["critical", "high", "low", "medium"] },
        "blocking": { "type": "boolean" },
        "requires_elevated_approval": { "type": "boolean" },
        "address": { "type": "string", "minLength": 1 },
        "detail_key": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "code", "path", "message"],
      "properties": {
        "source": { "enum": ["approval", "evaluator", "plan", "policy"] },
        "code": { "type": "string", "pattern": "^[a-z_]+$" },
        "path": { "type": "string", "pattern": "^\\$" },
        "message": { "type": "string" }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_schema",
        "synthetic_inputs",
        "notice",
        "run_id",
        "decision",
        "exit_code",
        "decision_basis",
        "change_set_digest",
        "plan_fixture_id",
        "change_context",
        "resource_changes",
        "findings",
        "finding_counts",
        "approval_gate",
        "errors",
        "evaluator",
        "non_claims"
      ],
      "properties": {
        "evidence_schema": { "const": "iac-lab-evidence/v1" },
        "synthetic_inputs": { "const": true },
        "notice": { "type": "string", "pattern": "^SYNTHETIC / LOCAL FIXTURES ONLY\\." },
        "run_id": { "$ref": "#/$defs/run_id" },
        "decision": { "$ref": "#/$defs/decision" },
        "exit_code": { "$ref": "#/$defs/exit_code" },
        "decision_basis": { "type": "string", "minLength": 1 },
        "change_set_digest": { "$ref": "#/$defs/digest" },
        "plan_fixture_id": { "type": ["string", "null"] },
        "change_context": { "$ref": "#/$defs/scope" },
        "resource_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["address", "type", "actions"],
            "properties": {
              "address": { "type": "string" },
              "type": { "type": "string" },
              "actions": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "finding_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "blocking", "non_blocking", "by_severity"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "blocking": { "type": "integer", "minimum": 0 },
            "non_blocking": { "type": "integer", "minimum": 0 },
            "by_severity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["critical", "high", "medium", "low"],
              "properties": {
                "critical": { "type": "integer", "minimum": 0 },
                "high": { "type": "integer", "minimum": 0 },
                "medium": { "type": "integer", "minimum": 0 },
                "low": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "approval_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "failed_checks"],
          "properties": {
            "result": { "enum": ["blocked", "not_evaluated", "valid"] },
            "failed_checks": {
              "type": "array",
              "items": { "type": "string", "pattern": "^IAC-APR-[0-9]{3}$" }
            }
          }
        },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } },
        "evaluator": { "$ref": "#/$defs/evaluator" },
        "non_claims": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "input_record": {
      "type": ["object", "null"],
      "required": ["filename", "sha256", "size_bytes"],
      "properties": {
        "filename": { "type": "string", "pattern": "^[^/\\\\:]+$" },
        "sha256": { "$ref": "#/$defs/sha256_or_null" },
        "size_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "fixture_id": { "type": ["string", "null"] },
        "approval_id": { "type": ["string", "null"] },
        "policy_id": { "type": ["string", "null"] },
        "policy_version": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_schema",
        "synthetic_inputs",
        "notice",
        "run_id",
        "decision",
        "exit_code",
        "evaluator",
        "inputs",
        "change_set_digest",
        "digest_scheme"
      ],
      "properties": {
        "provenance_schema": { "const": "iac-lab-provenance/v1" },
        "synthetic_inputs": { "const": true },
        "notice": { "type": "string", "pattern": "^SYNTHETIC / LOCAL FIXTURES ONLY\\." },
        "run_id": { "$ref": "#/$defs/run_id" },
        "decision": { "$ref": "#/$defs/decision" },
        "exit_code": { "$ref": "#/$defs/exit_code" },
        "evaluator": { "$ref": "#/$defs/evaluator" },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plan", "approval", "policy"],
          "properties": {
            "plan": { "$ref": "#/$defs/input_record" },
            "approval": { "$ref": "#/$defs/input_record" },
            "policy": { "$ref": "#/$defs/input_record" }
          }
        },
        "change_set_digest": { "$ref": "#/$defs/digest" },
        "digest_scheme": { "const": "iac-lab-changeset/v1" }
      }
    },
    "approval_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_schema",
        "synthetic_inputs",
        "notice",
        "run_id",
        "gate_result",
        "approval_provided",
        "presented",
        "expected",
        "checks",
        "note"
      ],
      "properties": {
        "assessment_schema": { "const": "iac-lab-approval-assessment/v1" },
        "synthetic_inputs": { "const": true },
        "notice": { "type": "string", "pattern": "^SYNTHETIC / LOCAL FIXTURES ONLY\\." },
        "run_id": { "$ref": "#/$defs/run_id" },
        "gate_result": { "enum": ["blocked", "not_evaluated", "valid"] },
        "approval_provided": { "type": "boolean" },
        "presented": { "type": ["object", "null"] },
        "expected": { "type": ["object", "null"] },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_id", "name", "result", "detail"],
            "properties": {
              "check_id": { "type": "string", "pattern": "^IAC-APR-[0-9]{3}$" },
              "name": { "type": "string" },
              "result": { "enum": ["fail", "not_evaluated", "pass"] },
              "detail": { "type": "string" }
            }
          }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
