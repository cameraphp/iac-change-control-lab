{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iac-change-control-lab:schema:approval:v1",
  "title": "Synthetic change approval record (iac-lab-approval/v1)",
  "description": "Lab-only approval record scoped to one change-set digest. Approvers are recorded by role, never by name. The record is data; the tool does not authenticate anyone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["synthetic", "contract_version", "approval_id", "status", "scope"],
  "properties": {
    "synthetic": { "const": true },
    "contract_version": { "const": "iac-lab-approval/v1" },
    "approval_id": { "type": "string", "pattern": "^APR-LAB-[0-9]{4}$" },
    "status": { "enum": ["approved", "not_submitted", "rejected"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_ref", "environment"],
      "properties": {
        "change_ref": { "type": "string", "pattern": "^LAB-CHG-[0-9]{4}$" },
        "environment": { "type": "string", "pattern": "^lab-[a-z0-9-]{1,30}$" }
      }
    },
    "change_set_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "policy_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "approval_level": { "enum": ["elevated", "standard"] },
    "approver_role": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
    "approved_destructive_addresses": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^labcloud_[a-z_]{1,40}\\.[a-z][a-z0-9_]{0,62}$" }
    },
    "notes": { "type": "string", "maxLength": 300 }
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": { "status": { "enum": ["approved", "rejected"] } }
      },
      "then": {
        "required": [
          "change_set_digest",
          "policy_version",
          "approval_level",
          "approver_role",
          "approved_destructive_addresses"
        ]
      }
    }
  ]
}
